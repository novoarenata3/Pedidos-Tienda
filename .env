# Base de Datos PostgreSQL
POSTGRES_DB=ejercicio4_db
POSTGRES_USER=ejercicio4_admin
POSTGRES_PASSWORD=secure_ejercicio4_pass
DATABASE_URL=jdbc:postgresql://db:5432/ejercicio4_db

# Redis Config (Cache e Idempotencia)
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Config (Cola de Eventos)
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=adminpass

# Configuración General
APP_PORT=8080
